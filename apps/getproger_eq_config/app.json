{
  "id": "getproger_eq_config",
  "title": "EQ Config",
  "description": "Audio profiles for BMW MGU",
  "version": "0.0.2",
  "vendor": "GetProger",
  "loggingId": "EQCF",
  "iconGlyph": "EQ",
  "signals": {
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_optional": "Audio manager unavailable",
      "_methods": [
        "getListMainSinks",
        "getListMainSinkSoundProperties",
        "setMainSinkSoundProperty",
        "getListSystemProperties",
        "setSystemProperty"
      ],
      "_broadcasts": [
        "mainSinkSoundPropertyChanged",
        "systemPropertyChanged"
      ]
    },
    "de.bmw.infotainment.am.carequalizing.CarSpecificEqualizingData": {
      "_instances": [
        "1",
        "2"
      ],
      "_optional": "Vehicle EQ data unavailable",
      "_methods": [
        "getAllEQData",
        "getEQData",
        "setEQData"
      ],
      "_broadcasts": [
        "eqDataChanged"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "EQ Config",
      "buttons": []
    }
  ],
  "settings": [
    {
      "key": "layout",
      "label": "Layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "standard",
          "Standard"
        ],
        [
          "full",
          "Full screen"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatic"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
